{
  "schema_version": 1,
  "upstream": {
    "lemonade_server": {
      "image": "ghcr.io/lemonade-sdk/lemonade-server:v11.9.0",
      "version": "v11.9.0"
    },
    "rocm": {
      "version": "7.2.1",
      "ubuntu_codename": "noble"
    }
  },
  "update_sources": {
    "lemonade-server": {
      "kind": "lemonade_server",
      "name": "Lemonade Server base image",
      "repository": "lemonade-sdk/lemonade",
      "tag_pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "include_prereleases": false,
      "container_image": "ghcr.io/lemonade-sdk/lemonade-server",
      "propagate_files": [
        "README.md",
        "base/Dockerfile",
        "base/Dockerfile.rocm",
        "forks/atomic-turboquant/Dockerfile.vulkan",
        "forks/cachyllama-heretek/Dockerfile",
        "forks/cachyllama-heretek/Dockerfile.vulkan",
        "forks/rocmfpx-heretek/Dockerfile"
      ]
    },
    "atomic-turboquant": {
      "kind": "github_release_assets",
      "name": "AtomicBot TurboQuant llama.cpp fork",
      "repository": "AtomicBot-ai/atomic-llama-cpp-turboquant",
      "tag_pattern": "^b[0-9]+-[0-9]+\\.[0-9]+\\.[0-9]+$",
      "include_prereleases": false,
      "version_build_arg": "TURBOQUANT_VERSION",
      "assets": [
        {
          "id": "rocm",
          "asset_pattern": "^llama-turboquant-linux-x64-rocm\\.tar\\.gz$",
          "gpu_target": null,
          "build_args": [
            {
              "image": "atomic-turboquant-combined",
              "asset": "TURBOQUANT_ROCM_ASSET",
              "sha256": "TURBOQUANT_ROCM_SHA256"
            }
          ]
        },
        {
          "id": "vulkan",
          "asset_pattern": "^llama-turboquant-linux-x64-vulkan\\.tar\\.gz$",
          "gpu_target": null,
          "build_args": [
            {
              "image": "atomic-turboquant-combined",
              "asset": "TURBOQUANT_VULKAN_ASSET",
              "sha256": "TURBOQUANT_VULKAN_SHA256"
            },
            {
              "image": "atomic-turboquant-vulkan",
              "asset": "TURBOQUANT_ASSET",
              "sha256": "TURBOQUANT_SHA256"
            }
          ]
        }
      ],
      "propagate_files": [
        "README.md",
        "docker-compose.yml",
        "forks/atomic-turboquant/Dockerfile",
        "forks/atomic-turboquant/Dockerfile.vulkan"
      ]
    },
    "cachyllama-heretek": {
      "kind": "github_release_assets",
      "name": "CachyLLama-BUILDER llama.cpp fork",
      "repository": "Heretek-AI/CachyLLama-BUILDER",
      "tag_pattern": "^b[0-9]+$",
      "include_prereleases": false,
      "version_build_arg": "CACHYLLAMA_VERSION",
      "assets": [
        {
          "id": "rocm",
          "asset_pattern": "^cachy-llama-{version}-ubuntu-rocm-gfx1151-x64\\.zip$",
          "gpu_target": "gfx1151",
          "build_args": [
            {
              "image": "cachyllama-heretek-combined",
              "asset": "CACHYLLAMA_ROCM_ASSET",
              "sha256": "CACHYLLAMA_ROCM_SHA256"
            }
          ]
        },
        {
          "id": "vulkan",
          "asset_pattern": "^cachy-llama-bin-ubuntu-vulkan-x64\\.tar\\.gz$",
          "gpu_target": null,
          "build_args": [
            {
              "image": "cachyllama-heretek-combined",
              "asset": "CACHYLLAMA_VULKAN_ASSET",
              "sha256": "CACHYLLAMA_VULKAN_SHA256"
            },
            {
              "image": "cachyllama-heretek-vulkan",
              "asset": "CACHYLLAMA_ASSET",
              "sha256": "CACHYLLAMA_SHA256"
            }
          ]
        }
      ],
      "propagate_files": [
        "README.md",
        "docker-compose.yml",
        "forks/cachyllama-heretek/Dockerfile",
        "forks/cachyllama-heretek/Dockerfile.vulkan"
      ]
    },
    "rocmfpx-heretek": {
      "kind": "github_release_assets",
      "name": "ROCmFPX-BUILDER llama.cpp fork (kingjones30 variant)",
      "repository": "Heretek-AI/ROCmFPX-BUILDER",
      "tag_pattern": "^b[0-9]+$",
      "include_prereleases": false,
      "version_build_arg": "ROCMFPX_VERSION",
      "assets": [
        {
          "id": "rocm",
          "asset_pattern": "^kingjones-rocmfpx-{version}-ubuntu-rocm-gfx1151-x64\\.zip$",
          "gpu_target": "gfx1151",
          "build_args": [
            {
              "image": "rocmfpx-heretek-combined",
              "asset": "ROCMFPX_ASSET",
              "sha256": "ROCMFPX_SHA256"
            }
          ]
        }
      ],
      "propagate_files": [
        "README.md",
        "docker-compose.yml",
        "forks/rocmfpx-heretek/Dockerfile"
      ]
    }
  },
  "images": [
    {
      "key": "runtime",
      "name": "Common Lemonade runtime base",
      "package": "lemon-base",
      "dockerfile": "base/Dockerfile",
      "context": "base",
      "default_tag": "lemonade-v11.9.0",
      "cache_scope": "runtime-lemonade-v11.9.0",
      "depends_on": null,
      "build_args": [
        "BASE_IMAGE=ghcr.io/lemonade-sdk/lemonade-server:v11.9.0"
      ]
    },
    {
      "key": "rocm-runtime",
      "name": "ROCm userspace runtime base",
      "package": "rocm-lemon",
      "dockerfile": "base/Dockerfile.rocm",
      "context": "base",
      "default_tag": "rocm-7.2.1",
      "cache_scope": "rocm-runtime-rocm-7.2.1",
      "depends_on": "runtime",
      "build_args": [
        "BASE_IMAGE=lemon-base:lemonade-v11.9.0",
        "ROCM_VERSION=7.2.1",
        "UBUNTU_CODENAME=noble"
      ]
    },
    {
      "key": "atomic-turboquant-combined",
      "name": "Atomic TurboQuant combined ROCm+Vulkan",
      "package": "atomic-lemon",
      "dockerfile": "forks/atomic-turboquant/Dockerfile",
      "context": "forks/atomic-turboquant",
      "default_tag": "combined-b10269-1.6.0",
      "cache_scope": "atomic-turboquant-combined-b10269-1.6.0",
      "depends_on": "rocm-runtime",
      "build_args": [
        "TURBOQUANT_VERSION=b10269-1.6.0",
        "TURBOQUANT_ROCM_ASSET=llama-turboquant-linux-x64-rocm.tar.gz",
        "TURBOQUANT_ROCM_SHA256=e7758e3191827460de13976284160878d02920acb17d54007bd548521def7dc9",
        "TURBOQUANT_VULKAN_ASSET=llama-turboquant-linux-x64-vulkan.tar.gz",
        "TURBOQUANT_VULKAN_SHA256=a0a3bc7b067fbac5e402ff3d603c50eaeffe505c5f576e6affb98ecaa9706aa3"
      ]
    },
    {
      "key": "atomic-turboquant-vulkan",
      "name": "Atomic TurboQuant Vulkan-only",
      "package": "atomic-lemon",
      "dockerfile": "forks/atomic-turboquant/Dockerfile.vulkan",
      "context": ".",
      "default_tag": "vulkan-b10269-1.6.0",
      "cache_scope": "atomic-turboquant-vulkan-b10269-1.6.0",
      "depends_on": "runtime",
      "build_args": [
        "BASE_IMAGE=lemon-base:lemonade-v11.9.0",
        "TURBOQUANT_VERSION=b10269-1.6.0",
        "TURBOQUANT_ASSET=llama-turboquant-linux-x64-vulkan.tar.gz",
        "TURBOQUANT_SHA256=a0a3bc7b067fbac5e402ff3d603c50eaeffe505c5f576e6affb98ecaa9706aa3"
      ]
    },
    {
      "key": "cachyllama-heretek-combined",
      "name": "CachyLlama Heretek combined ROCm+Vulkan",
      "package": "cachy-lemon",
      "dockerfile": "forks/cachyllama-heretek/Dockerfile",
      "context": "forks/cachyllama-heretek",
      "default_tag": "combined-b1036-gfx1151",
      "cache_scope": "cachyllama-heretek-combined-b1036-gfx1151",
      "depends_on": "runtime",
      "build_args": [
        "CACHYLLAMA_VERSION=b1036",
        "CACHYLLAMA_ROCM_ASSET=cachy-llama-b1036-ubuntu-rocm-gfx1151-x64.zip",
        "CACHYLLAMA_ROCM_SHA256=b56cf63a6895f03173b7a2e4389ea2266241ade3c87ab6557cb14909f02c75b4",
        "CACHYLLAMA_VULKAN_ASSET=cachy-llama-bin-ubuntu-vulkan-x64.tar.gz",
        "CACHYLLAMA_VULKAN_SHA256=7241a3611f3bbea1e3a852178f73ed8376017c21fce5c116094cc8380e476604"
      ]
    },
    {
      "key": "cachyllama-heretek-vulkan",
      "name": "CachyLlama Heretek Vulkan-only",
      "package": "cachy-lemon",
      "dockerfile": "forks/cachyllama-heretek/Dockerfile.vulkan",
      "context": ".",
      "default_tag": "vulkan-b1036",
      "cache_scope": "cachyllama-heretek-vulkan-b1036",
      "depends_on": "runtime",
      "build_args": [
        "BASE_IMAGE=lemon-base:lemonade-v11.9.0",
        "CACHYLLAMA_VERSION=b1036",
        "CACHYLLAMA_ASSET=cachy-llama-bin-ubuntu-vulkan-x64.tar.gz",
        "CACHYLLAMA_SHA256=7241a3611f3bbea1e3a852178f73ed8376017c21fce5c116094cc8380e476604"
      ]
    },
    {
      "key": "rocmfpx-heretek-combined",
      "name": "ROCmFPX Heretek combined HIP+Vulkan",
      "package": "fpx-lemon",
      "dockerfile": "forks/rocmfpx-heretek/Dockerfile",
      "context": "forks/rocmfpx-heretek",
      "default_tag": "combined-b1050-gfx1151",
      "cache_scope": "rocmfpx-heretek-combined-b1050-gfx1151",
      "depends_on": "runtime",
      "build_args": [
        "ROCMFPX_VERSION=b1050",
        "ROCMFPX_ASSET=kingjones-rocmfpx-b1050-ubuntu-rocm-gfx1151-x64.zip",
        "ROCMFPX_SHA256=2d39092220dadbf3cbc093274146b115af448f514a102a2347bd0a06e6470f9f"
      ]
    }
  ]
}
