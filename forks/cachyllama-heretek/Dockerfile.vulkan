# Vulkan-only variant of the CachyLLama-BUILDER fork image.
#
# Vulkan needs no ROCm userspace runtime, so this variant builds FROM the
# lightweight lemon-base base rather than rocm-lemon. Build
# with the repo root as context, e.g.:
#
#   docker build \
#     -f forks/cachyllama-heretek/Dockerfile.vulkan \
#     -t cachy-lemon:vulkan-<version> \
#     .
#
# No version/asset/checksum defaults are hardcoded on purpose -- pass all
# three as build args, pinned to a release you have verified yourself.
ARG BASE_IMAGE=lemon-base:lemonade-v11.9.0
FROM ${BASE_IMAGE}

USER root

ARG CACHYLLAMA_VERSION
ARG CACHYLLAMA_ASSET
ARG CACHYLLAMA_SHA256

RUN test -n "${CACHYLLAMA_VERSION}" || (echo "CACHYLLAMA_VERSION build-arg is required" >&2 && false) \
    && test -n "${CACHYLLAMA_ASSET}" || (echo "CACHYLLAMA_ASSET build-arg is required" >&2 && false) \
    && test -n "${CACHYLLAMA_SHA256}" || (echo "CACHYLLAMA_SHA256 build-arg is required" >&2 && false)

RUN mkdir -p /opt/lemonade/custom-bin/cachyllama/vulkan \
    && cd /tmp \
    && curl -fsSL -o cachyllama-vulkan.tar.gz \
        "https://github.com/Heretek-AI/CachyLLama-BUILDER/releases/download/${CACHYLLAMA_VERSION}/${CACHYLLAMA_ASSET}" \
    && echo "${CACHYLLAMA_SHA256}  cachyllama-vulkan.tar.gz" | sha256sum --check --strict \
    && tar -xzf cachyllama-vulkan.tar.gz -C /opt/lemonade/custom-bin/cachyllama/vulkan \
    && rm -f cachyllama-vulkan.tar.gz \
    && chmod +x /opt/lemonade/custom-bin/cachyllama/vulkan/llama-server \
    && chown -R lemonade:lemonade /opt/lemonade/custom-bin/cachyllama

COPY forks/cachyllama-heretek/config.default.vulkan.json /usr/local/share/lemonade/config.default.json
RUN chown lemonade:lemonade /usr/local/share/lemonade/config.default.json

USER lemonade

# ENTRYPOINT/CMD inherited from the common runtime image.
