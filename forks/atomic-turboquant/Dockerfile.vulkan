# Vulkan variant of the atomic-llama-cpp-turboquant fork image.
#
# Vulkan needs no ROCm userspace runtime, so this variant builds directly
# FROM the plain upstream lemonade-server image (Vulkan libraries are already
# part of that image's apt install list) instead of the shared
# lemonade-rocm-runtime base used by the combined ROCm+Vulkan variant
# (Dockerfile).
#
# Because it skips the shared rocm-runtime base, this Dockerfile re-applies
# the two things that base normally provides: the render/video group
# membership for device passthrough, and the generic config-seeding
# entrypoint script. Build with the repo root as context so it can reach
# ../../base/docker-entrypoint.sh, e.g.:
#
#   docker build \
#     -f forks/atomic-turboquant/Dockerfile.vulkan \
#     -t lemonade-atomic-turboquant:vulkan-<version> \
#     .
#
# No version/asset/checksum defaults are hardcoded on purpose -- pass all
# three as build args, pinned to a release you have verified yourself. Look
# up the exact vulkan asset filename for the release you want and compute
# its sha256 yourself; do not reuse any ROCm checksum for this variant.
ARG BASE_IMAGE=ghcr.io/lemonade-sdk/lemonade-server:v11.9.0
FROM ${BASE_IMAGE}

USER root

ARG TURBOQUANT_VERSION
ARG TURBOQUANT_ASSET
ARG TURBOQUANT_SHA256

RUN test -n "${TURBOQUANT_VERSION}" || (echo "TURBOQUANT_VERSION build-arg is required" >&2 && false) \
    && test -n "${TURBOQUANT_ASSET}" || (echo "TURBOQUANT_ASSET build-arg is required" >&2 && false) \
    && test -n "${TURBOQUANT_SHA256}" || (echo "TURBOQUANT_SHA256 build-arg is required" >&2 && false)

RUN groupadd -f render \
    && groupadd -f video \
    && usermod -aG render,video lemonade

RUN mkdir -p /opt/lemonade/custom-bin/turboquant/vulkan \
    && cd /tmp \
    && curl -fsSL -o turboquant.tar.gz \
        "https://github.com/AtomicBot-ai/atomic-llama-cpp-turboquant/releases/download/${TURBOQUANT_VERSION}/${TURBOQUANT_ASSET}" \
    && echo "${TURBOQUANT_SHA256}  turboquant.tar.gz" | sha256sum --check --strict \
    && tar -xzf turboquant.tar.gz --strip-components=3 -C /opt/lemonade/custom-bin/turboquant/vulkan \
    && rm -f turboquant.tar.gz \
    && chmod +x /opt/lemonade/custom-bin/turboquant/vulkan/llama-server \
    && chown -R lemonade:lemonade /opt/lemonade/custom-bin/turboquant

COPY forks/atomic-turboquant/config.default.vulkan.json /usr/local/share/lemonade/config.default.json
RUN chown lemonade:lemonade /usr/local/share/lemonade/config.default.json

COPY base/docker-entrypoint.sh /usr/local/bin/lemonade-entrypoint
RUN chmod +x /usr/local/bin/lemonade-entrypoint

USER lemonade

ENTRYPOINT ["/usr/local/bin/lemonade-entrypoint"]
CMD ["./lemond", "--host", "0.0.0.0"]
